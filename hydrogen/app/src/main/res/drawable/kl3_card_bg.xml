<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/kl3_focus_stroke" />
            <corners android:radius="@dimen/kl3_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_surface" />
            <stroke android:width="1dp" android:color="@color/kl3_divider" />
            <corners android:radius="@dimen/kl3_card_radius" />
        </shape>
    </item>
</selector>
