<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#78350F" android:endColor="#231D16" />
            <stroke android:width="2dp" android:color="@color/kl3_focus_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#57260B" android:endColor="#1D1914" />
            <stroke android:width="1dp" android:color="#6E4423" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
