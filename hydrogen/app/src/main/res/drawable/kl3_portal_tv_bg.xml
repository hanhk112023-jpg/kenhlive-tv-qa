<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#0C4A6E" android:endColor="#1D2228" />
            <stroke android:width="2dp" android:color="@color/kl3_focus_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#08334A" android:endColor="#1A1D21" />
            <stroke android:width="1dp" android:color="#1E4D6B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
