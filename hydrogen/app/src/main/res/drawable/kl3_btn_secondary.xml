<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kl3_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/kl3_focus_stroke" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#28241D" />
            <stroke android:width="1dp" android:color="#443D33" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
