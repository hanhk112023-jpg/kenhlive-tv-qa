<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- Top Live Scoreboard HUD (TV) -->
    <LinearLayout
        android:id="@+id/sportsTopHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC141210"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/tvSportsStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_badge_live"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/kl3_badge_live"
            android:textColor="@color/kl3_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSportsMatchScoreboard"
            style="@style/kl3_TextDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvSportsMinute"
            style="@style/kl3_TextDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kl3_score_live_gold"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Bottom Sports OSD (TV) with Custom Pill Buttons & Icons -->
    <LinearLayout
        android:id="@+id/sportsBottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC141210"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingVertical="16dp">

        <Button
            android:id="@+id/btnSportsPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/kl3_btn_primary"
            android:drawableStart="@drawable/ic_kl3_pause"
            android:drawablePadding="8dp"
            android:paddingHorizontal="18dp"
            android:text="TẠM DỪNG"
            android:textColor="@color/kl3_text_primary"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/tvSportsSourceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/kl3_score_live_gold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSportsSwitchSource"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/kl3_btn_secondary"
            android:drawableStart="@drawable/ic_kl3_sources"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:text="ĐỔI NGUỒN"
            android:textColor="@color/kl3_text_primary"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSportsOptions"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/kl3_btn_secondary"
            android:drawableStart="@drawable/ic_kl3_options"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:text="@string/kl3_player_options"
            android:textColor="@color/kl3_text_primary"
            app:backgroundTint="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSportsPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="20dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
