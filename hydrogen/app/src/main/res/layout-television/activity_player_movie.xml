<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/movieOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC141210"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/tvMoviePlayerTitle"
            style="@style/kl3_TextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMovieTimeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/kl3_text_secondary"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekMovie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:progressTint="@color/kl3_accent_red"
                android:thumbTint="@color/kl3_score_live_gold" />

            <TextView
                android:id="@+id/tvMovieTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/kl3_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovieRewind"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_secondary"
                android:drawableStart="@drawable/ic_kl3_rewind"
                android:drawablePadding="6dp"
                android:paddingHorizontal="14dp"
                android:text="10s"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnMoviePlayPause"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_primary"
                android:drawableStart="@drawable/ic_kl3_pause"
                android:drawablePadding="8dp"
                android:paddingHorizontal="18dp"
                android:text="TẠM DỪNG"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnMovieForward"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/kl3_btn_secondary"
                android:drawableStart="@drawable/ic_kl3_forward"
                android:drawablePadding="6dp"
                android:paddingHorizontal="14dp"
                android:text="10s"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnMovieNextEp"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_secondary"
                android:paddingHorizontal="16dp"
                android:text="TẬP TIẾP →"
                android:textColor="@color/kl3_score_live_gold"
                android:visibility="gone"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnMovieEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_secondary"
                android:drawableStart="@drawable/ic_kl3_channels"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                android:text="TẬP PHIM"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnMovieOptions"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/kl3_btn_secondary"
                android:drawableStart="@drawable/ic_kl3_options"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                android:text="@string/kl3_player_options"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="20dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
