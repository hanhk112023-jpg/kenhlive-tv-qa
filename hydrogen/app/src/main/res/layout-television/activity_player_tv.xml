<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <LinearLayout
        android:id="@+id/tvPlayerOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC141210"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingVertical="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTvChannelLogo"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:background="@drawable/kl3_logo_plate"
                android:contentDescription="@null"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChannelTitle"
                    style="@style/kl3_TextDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvChannelEpgNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/progressTvEpg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progressBackgroundTint="@color/kl3_divider"
                    android:progressTint="@color/kl3_accent_red" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPrevChannel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_secondary"
                android:paddingHorizontal="16dp"
                android:text="CH -"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnNextChannel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_secondary"
                android:paddingHorizontal="16dp"
                android:text="CH +"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnChannelList"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_btn_primary"
                android:drawableStart="@drawable/ic_kl3_channels"
                android:drawablePadding="8dp"
                android:paddingHorizontal="18dp"
                android:text="KÊNH"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btnTvOptions"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/kl3_btn_secondary"
                android:drawableStart="@drawable/ic_kl3_options"
                android:drawablePadding="8dp"
                android:paddingHorizontal="16dp"
                android:text="@string/kl3_player_options"
                android:textColor="@color/kl3_text_primary"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="20dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
