<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/kl3_page_margin">

        <TextView
            style="@style/kl3_TextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KENHLIVE HUB"
            android:textSize="@dimen/kl3_hero_title_size" />

        <!-- 3 Large Horizontal Portal Cards with Distinct Gradients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <!-- Sports Portal -->
            <LinearLayout
                android:id="@+id/cardHubSports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/kl3_hero_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kl3_badge_live"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="THỂ THAO"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/kl3_TextDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Thể thao"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Trực tiếp bóng đá &amp; thể thao"
                    android:textColor="@color/kl3_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHubSportsCount"
                    style="@style/kl3_TextDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NHẤN OK →"
                    android:textColor="@color/kl3_accent_red"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- IPTV Portal -->
            <LinearLayout
                android:id="@+id/cardHubIptv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/kl3_portal_tv_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kl3_badge_upcoming"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="IPTV"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/kl3_TextDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Truyền hình"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kênh TV Việt Nam &amp; quốc tế"
                    android:textColor="@color/kl3_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHubIptvCount"
                    style="@style/kl3_TextDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NHẤN OK →"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Movies Portal -->
            <LinearLayout
                android:id="@+id/cardHubMovies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/kl3_portal_movies_bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kl3_badge_finished"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="KKPHIM"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/kl3_TextDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Phim truyện"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Kho phim mới cập nhật"
                    android:textColor="@color/kl3_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvHubMoviesCount"
                    style="@style/kl3_TextDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NHẤN OK →"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/kl3_TextDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ĐANG PHÁT"
            android:textSize="18sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHubLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHubSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/kl3_card_bg"
                android:text="Cài đặt"
                android:textColor="@color/kl3_text_primary" />

            <Button
                android:id="@+id/btnHubReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/kl3_card_bg"
                android:text="Báo lỗi"
                android:textColor="@color/kl3_text_primary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
