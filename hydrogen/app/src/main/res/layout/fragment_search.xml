<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg_primary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/kl3_page_margin"
    android:paddingTop="20dp">

    <TextView
        style="@style/kl3_TextDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kl3_nav_search"
        android:textSize="@dimen/kl3_section_title_size" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/kl3_card_bg"
            android:hint="Tìm trận đấu, kênh TV hoặc phim..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/kl3_text_primary"
            android:textColorHint="@color/kl3_text_muted" />

        <Button
            android:id="@+id/btnSearchGo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/kl3_accent_red"
            android:text="TÌM"
            android:textColor="@color/kl3_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSearch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
