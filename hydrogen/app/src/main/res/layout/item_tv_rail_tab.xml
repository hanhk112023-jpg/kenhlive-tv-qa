<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/kl3_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingEnd="12dp">

    <!-- Red active indicator bar -->
    <View
        android:id="@+id/railIndicator"
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:background="@color/kl3_accent_red"
        android:visibility="invisible" />

    <!-- 24dp Icon -->
    <ImageView
        android:id="@+id/railIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null" />

    <!-- Full Label (never truncated or wrapped on 1080p TV) -->
    <TextView
        android:id="@+id/railLabel"
        style="@style/kl3_TextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:singleLine="true"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Red Live Dot -->
    <View
        android:id="@+id/railLiveDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/kl3_live_dot"
        android:visibility="gone" />

</LinearLayout>
