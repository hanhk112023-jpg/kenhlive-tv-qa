<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg_primary"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/phoneToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/kl3_surface"
        app:title="@string/app_name"
        app:titleTextColor="@color/kl3_accent_red" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/phoneBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/kl3_surface"
        app:itemIconTint="@color/kl3_text_primary"
        app:itemTextColor="@color/kl3_text_secondary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
