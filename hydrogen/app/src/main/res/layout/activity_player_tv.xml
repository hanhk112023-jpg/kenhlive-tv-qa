<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- Phone TV Channel Overlay -->
    <LinearLayout
        android:id="@+id/tvPlayerOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC141210"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivTvChannelLogo"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:background="@drawable/kl3_logo_plate"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvChannelTitle"
                    style="@style/kl3_TextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChannelEpgNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/progressTvEpg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progressBackgroundTint="@color/kl3_divider"
                    android:progressTint="@color/kl3_accent_red" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPrevChannel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/kl3_card_bg"
                android:text="CH-"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnNextChannel"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/kl3_card_bg"
                android:text="CH+"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnChannelList"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/kl3_accent_red"
                android:text="KÊNH"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTvOptions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/kl3_card_bg"
                android:text="..."
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="16dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
