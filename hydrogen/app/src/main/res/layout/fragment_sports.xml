<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kl3_bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/kl3_page_margin"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Rich Hero Banner -->
        <LinearLayout
            android:id="@+id/heroContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_hero_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHeroBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kl3_badge_live"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/kl3_badge_live"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeroLeague"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/kl3_text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroTitle"
                style="@style/kl3_TextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="@dimen/kl3_hero_title_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeroHomeLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/kl3_logo_plate"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/tvHeroScore"
                    style="@style/kl3_TextDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:textColor="@color/kl3_score_live_gold"
                    android:textSize="28sp" />

                <ImageView
                    android:id="@+id/ivHeroAwayLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/kl3_logo_plate"
                    android:contentDescription="@null"
                    android:padding="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvHeroCta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kl3_badge_live"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="XEM NGAY →"
                    android:textColor="@color/kl3_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHeroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/kl3_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Filter Chips (Tất cả / Đang live / Sắp đá) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                style="@style/kl3_TextBody"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Tất cả"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFilterLive"
                style="@style/kl3_TextBody"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/kl3_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Đang live"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipFilterUpcoming"
                style="@style/kl3_TextBody"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/kl3_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="Sắp đá"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressSports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSportsEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/kl3_empty_matches"
            android:textColor="@color/kl3_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
