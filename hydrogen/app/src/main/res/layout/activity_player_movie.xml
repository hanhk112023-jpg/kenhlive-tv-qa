<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- VOD Cinema OSD (Phone) -->
    <LinearLayout
        android:id="@+id/movieOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC141210"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvMoviePlayerTitle"
            style="@style/kl3_TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMovieTimeCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/kl3_text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekMovie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:progressTint="@color/kl3_accent_red"
                android:thumbTint="@color/kl3_score_live_gold" />

            <TextView
                android:id="@+id/tvMovieTimeTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/kl3_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMovieRewind"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/kl3_card_bg"
                android:text="-10s"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnMoviePlayPause"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/kl3_accent_red"
                android:text="PAUSE"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnMovieForward"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/kl3_card_bg"
                android:text="+10s"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnMovieNextEp"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/kl3_card_bg"
                android:text="TẬP TIẾP"
                android:textColor="@color/kl3_score_live_gold"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnMovieEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/kl3_card_bg"
                android:text="TẬP"
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnMovieOptions"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/kl3_card_bg"
                android:text="..."
                android:textColor="@color/kl3_text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="16dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
