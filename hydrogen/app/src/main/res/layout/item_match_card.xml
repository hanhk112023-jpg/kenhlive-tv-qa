<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/kl3_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:padding="14dp">

    <!-- Top row: State Badge + League + Right Corner (Minute or Kickoff) -->
    <TextView
        android:id="@+id/tvStateBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/kl3_badge_live"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="@string/kl3_badge_live"
        android:textColor="@color/kl3_text_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLeagueName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/kl3_text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tvStateBadge"
        app:layout_constraintEnd_toStartOf="@id/tvRightCorner"
        app:layout_constraintStart_toEndOf="@id/tvStateBadge"
        app:layout_constraintTop_toTopOf="@id/tvStateBadge" />

    <TextView
        android:id="@+id/tvRightCorner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/kl3_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvStateBadge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvStateBadge" />

    <!-- Middle row: Home Team + Fixed Center Score/VS + Away Team -->
    <ImageView
        android:id="@+id/ivHomeLogo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="14dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStateBadge" />

    <TextView
        android:id="@+id/tvHomeTeam"
        style="@style/kl3_TextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
        app:layout_constraintEnd_toStartOf="@id/tvCenterScore"
        app:layout_constraintStart_toEndOf="@id/ivHomeLogo"
        app:layout_constraintTop_toTopOf="@id/ivHomeLogo" />

    <TextView
        android:id="@+id/tvCenterScore"
        style="@style/kl3_TextDisplay"
        android:layout_width="@dimen/kl3_upcoming_time_col_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/kl3_vs"
        android:textColor="@color/kl3_score_live_gold"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
        app:layout_constraintEnd_toStartOf="@id/tvAwayTeam"
        app:layout_constraintStart_toEndOf="@id/tvHomeTeam"
        app:layout_constraintTop_toTopOf="@id/ivHomeLogo" />

    <TextView
        android:id="@+id/tvAwayTeam"
        style="@style/kl3_TextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
        app:layout_constraintEnd_toStartOf="@id/ivAwayLogo"
        app:layout_constraintStart_toEndOf="@id/tvCenterScore"
        app:layout_constraintTop_toTopOf="@id/ivHomeLogo" />

    <ImageView
        android:id="@+id/ivAwayLogo"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@id/ivHomeLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivHomeLogo" />

    <!-- Bottom row: Commentator + Kickoff + View Count -->
    <TextView
        android:id="@+id/tvBottomMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/kl3_text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivHomeLogo" />

</androidx.constraintlayout.widget.ConstraintLayout>
