<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false" />

    <!-- Top Scoreboard (Phone) -->
    <LinearLayout
        android:id="@+id/sportsTopHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#BB141210"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvSportsStateBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/kl3_badge_live"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="@string/kl3_badge_live"
            android:textColor="@color/kl3_text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSportsMatchScoreboard"
            style="@style/kl3_TextBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSportsMinute"
            style="@style/kl3_TextDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/kl3_score_live_gold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom Controls (Phone) -->
    <LinearLayout
        android:id="@+id/sportsBottomOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#BB141210"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <Button
            android:id="@+id/btnSportsPlayPause"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/kl3_accent_red"
            android:text="PAUSE"
            android:textColor="@color/kl3_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvSportsSourceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/kl3_score_live_gold"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSportsSwitchSource"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/kl3_card_bg"
            android:text="NGUỒN"
            android:textColor="@color/kl3_text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSportsOptions"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/kl3_card_bg"
            android:text="@string/kl3_player_options"
            android:textColor="@color/kl3_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSportsPlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#DD141210"
        android:padding="16dp"
        android:textColor="@color/kl3_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
